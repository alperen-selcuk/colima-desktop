{
  "id": "mongodb-mongo-express",
  "name": "MongoDB + Mongo Express",
  "description": "MongoDB database with Mongo Express, a web-based admin UI for browsing collections and documents.",
  "category": "database",
  "tags": ["mongodb", "nosql", "mongo-express"],
  "icon": "mongodb",
  "website": "https://www.mongodb.com",
  "source": {
    "name": "docker/awesome-compose (official mongo + mongo-express images)",
    "url": "https://github.com/docker/awesome-compose",
    "license": "CC0-1.0"
  },
  "architectures": ["amd64", "arm64"],
  "minMemoryMB": 512,
  "variables": [
    { "name": "MONGO_USER", "type": "string", "label": "MongoDB root user", "default": "app" },
    { "name": "MONGO_PASSWORD", "type": "password", "label": "MongoDB root password", "length": 20 },
    { "name": "MONGO_PORT", "type": "port", "label": "MongoDB port", "default": 27017 },
    { "name": "MONGO_EXPRESS_PORT", "type": "port", "label": "Mongo Express port", "default": 8082 },
    { "name": "MONGO_EXPRESS_USER", "type": "string", "label": "Mongo Express login user", "default": "admin" },
    { "name": "MONGO_EXPRESS_PASSWORD", "type": "password", "label": "Mongo Express login password", "length": 20 }
  ],
  "endpoints": [
    {
      "name": "Mongo Express",
      "url": "http://localhost:${MONGO_EXPRESS_PORT}",
      "username": "${MONGO_EXPRESS_USER}",
      "password": "${MONGO_EXPRESS_PASSWORD}",
      "primary": true
    },
    {
      "name": "Connection string",
      "value": "mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:${MONGO_PORT}/"
    }
  ],
  "ready": { "type": "healthy", "timeoutSec": 90 },
  "notes": "Mongo Express is protected by HTTP basic auth using MONGO_EXPRESS_USER/PASSWORD, separate from the MongoDB credentials."
}
